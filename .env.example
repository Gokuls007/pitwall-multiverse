# FastF1 cache directory (relative to repo root)
FASTF1_CACHE_DIR=data/cache

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend -> backend base URL
VITE_API_BASE_URL=http://localhost:8000

# Optional: LLM key for the Phase 8 natural-language divergence summary ONLY.
# The core simulation never uses an LLM. Leave blank to use the deterministic
# template fallback.
ANTHROPIC_API_KEY=
